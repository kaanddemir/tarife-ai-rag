# --- Database (Supabase cloud) ---
# Use the Supabase "Session pooler" connection string (IPv4, port 5432): switch the
# driver to psycopg and require SSL. Do NOT use the transaction pooler (port 6543) —
# it breaks prepared statements with psycopg/SQLAlchemy.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local Postgres alternative (if you run your own):
#   postgresql+psycopg://<user>:<password>@localhost:5432/<db>

# --- Generation LLM (hosted open-model API, OpenAI-compatible) ---
# Groq:       https://api.groq.com/openai/v1 model e.g. qwen/qwen3-32b
# Together:   https://api.together.xyz/v1
# OpenRouter: https://openrouter.ai/api/v1
PROVIDER_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_API_KEY=
MODEL=qwen/qwen3-32b

# --- Retrieval ---
EMBED_MODEL=BAAI/bge-m3
TOP_K=8

# --- Auth (Supabase) ---
# Project URL — used to fetch the public JWKS for verifying asymmetric (ES256/RS256)
# access tokens, which is Supabase's current default. Not secret.
SUPABASE_URL=https://<ref>.supabase.co
# Legacy shared JWT secret (Settings → API → JWT Secret). Only needed for older projects
# still signing tokens with HS256; asymmetric projects use the JWKS above. Leave empty
# unless you have one: an unset secret makes the backend reject HS256 tokens outright,
# which is what stops anyone from forging one against a placeholder value.
SUPABASE_JWT_SECRET=

# --- Message quotas (primary abuse control) ---
GUEST_MESSAGE_LIMIT=5        # guest (anonymous) lifetime messages before sign-in
GUEST_IP_DAILY_LIMIT=15      # backstop: max anonymous messages per IP per day
DAILY_MESSAGE_LIMIT=20       # signed-in messages per day
# Comma-separated emails exempt from all quotas (your own test/admin account). Only
# works when signed in with that email (anonymous guests have no email).
QUOTA_EXEMPT_EMAILS=

# --- CORS ---
# Comma-separated list of allowed frontend origins (add your prod domain here).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limit (coarse burst backstop; slowapi syntax) ---
CHAT_RATE_LIMIT=20/minute
COMPARE_RATE_LIMIT=30/minute
