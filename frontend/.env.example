# Base URL of the TarifeAI backend API.
# Inlined into the build by Next (NEXT_PUBLIC_*), so set it for every build/env.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Supabase Auth (public, safe to ship to the browser) ---
# Supabase Dashboard → Settings → API → Project URL and anon (public) key.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
